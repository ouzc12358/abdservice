{
  "name": "secure-edge-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run test && npm run types && npm run deploy:dry",
    "deploy": "wrangler deploy --config wrangler.jsonc --keep-vars",
    "deploy:dry": "wrangler deploy --config wrangler.jsonc --dry-run",
    "dev": "wrangler dev --config wrangler.jsonc",
    "secrets:generate": "node scripts/generate-deploy-secrets.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "node --test",
    "types": "wrangler types --config wrangler.jsonc --check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "22.20.2",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
